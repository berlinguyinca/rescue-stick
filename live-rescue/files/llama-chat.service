[Unit]
Description=fiehnlab-live local chat LLM (llama.cpp, qwen3-local by default)
After=network.target
ConditionPathExists=/opt/models

[Service]
Type=simple
EnvironmentFile=-/etc/default/llama-chat
ExecStart=/usr/local/bin/fiehnlab-llama llama-server --host 127.0.0.1 --port 8080 --alias ${LLAMA_CHAT_ALIAS} -c ${LLAMA_CHAT_CTX} -np 1 --reasoning off -m ${LLAMA_CHAT_MODEL}
Restart=on-failure
RestartSec=3
User=nobody
Group=nogroup
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
